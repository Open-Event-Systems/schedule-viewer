{
  "compilerOptions": {
    "rootDir": "./",
    "outDir": "./dist",
    "composite": true,
    "module": "nodenext",
    "target": "esnext",
    "types": ["vite/client"],
    "noUncheckedIndexedAccess": true,
    "strict": true,
    "jsx": "react-jsx",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true
  },
  "references": [{ "path": "../lib" }],
  "include": ["./src/**/*", "./.storybook/**/*"]
}
