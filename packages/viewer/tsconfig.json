{
  "compilerOptions": {
    "incremental": true,
    "composite": true,
    "rootDir": "./",
    "outDir": "./dist",
    "module": "nodenext",
    "target": "esnext",
    "types": ["vite/client", "vite-plugin-pwa/client", "@types/umami"],
    "noEmit": true,
    "noUncheckedIndexedAccess": true,
    "strict": true,
    "jsx": "react-jsx",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true
  },
  "references": [
    { "path": "../map" },
    { "path": "../react" },
    { "path": "../lib" }
  ],
  "include": ["./src/**/*", "./.storybook/*"]
}
